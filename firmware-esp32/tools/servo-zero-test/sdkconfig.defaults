CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=100
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Keep error/retry logging in the UART main task from exhausting its stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Gerber_PCB1_2026-09-02 candidate wiring. Verify against the assembled board.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SERVO_ZERO_SDA_GPIO=11
CONFIG_SERVO_ZERO_SCL_GPIO=12
CONFIG_SERVO_ZERO_OE_GPIO=1
CONFIG_SERVO_ZERO_PCA9685_ADDRESS=0x40
CONFIG_SERVO_ZERO_PWM_FREQUENCY_HZ=50
CONFIG_SERVO_ZERO_I2C_SPEED_HZ=400000
CONFIG_SERVO_ZERO_TCP_DIAG_ENABLED=y
CONFIG_SERVO_ZERO_TCP_DIAG_WIFI_SSID="牛来快跑-DIAG"
CONFIG_SERVO_ZERO_TCP_DIAG_WIFI_PASSWORD="牛来快跑-Diag"
CONFIG_SERVO_ZERO_TCP_DIAG_PORT=3333

# Generic RC-servo midpoint candidate, not a measured joint calibration.
CONFIG_SERVO_ZERO_PULSE_US=1500
CONFIG_SERVO_ZERO_REFRESH_MS=20
