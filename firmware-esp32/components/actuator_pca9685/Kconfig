menu "牛来快跑 PCA9685"

    config NIULAI_PCA9685_SDA_PIN
        int "I2C SDA GPIO"
        range 0 48
        default 11

    config NIULAI_PCA9685_SCL_PIN
        int "I2C SCL GPIO"
        range 0 48
        default 12

    config NIULAI_PCA9685_OE_PIN
        int "/OE GPIO (active low, 10k pull-up)"
        range 0 48
        default 1

    config NIULAI_PCA9685_I2C_ADDR
        hex "PCA9685 I2C address"
        range 0x00 0x7F
        default 0x40

    config NIULAI_PCA9685_I2C_TIMEOUT_MS
        int "PCA9685 I2C transaction timeout (ms)"
        range 1 1000
        default 50
        help
            Every PCA9685 transaction is bounded by this timeout. A timeout
            must leave the safety gate able to assert /OE and report a
            latched actuator fault.

    config NIULAI_PCA9685_PWM_FREQ_HZ
        int "PWM frequency (Hz)"
        range 24 1526
        default 50

    comment "Formal four-leg calibration (FL/FR/RL/RR semantic order)"

    config NIULAI_FORMAL_FL_HIP_REST_US
        int "FL hip rest pulse (us)"
        range 500 2500
        default 1672

    config NIULAI_FORMAL_FL_KNEE_REST_US
        int "FL knee rest pulse (us)"
        range 500 2500
        default 1748

    config NIULAI_FORMAL_FR_HIP_REST_US
        int "FR hip rest pulse (us)"
        range 500 2500
        default 1494

    config NIULAI_FORMAL_FR_KNEE_REST_US
        int "FR knee rest pulse (us)"
        range 500 2500
        default 1165

    config NIULAI_FORMAL_RL_HIP_REST_US
        int "RL hip rest pulse (us)"
        range 500 2500
        default 1764

    config NIULAI_FORMAL_RL_KNEE_REST_US
