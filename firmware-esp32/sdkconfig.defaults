# 牛来快跑 firmware-esp32 defaults. The personal sdkconfig is gitignored;
# these values are the project baseline and must not be weakened silently.
CONFIG_IDF_TARGET="esp32s3"

# Bluetooth: NimBLE only, peripheral role, max 1 connection, Bluedroid off.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# N16R8: octal PSRAM at 80 MHz and 16 MB flash. Replace when the mounted
# ESP32-S3-WROOM-1 memory variant is verified.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The current runtime embeds three 320x170 RGB565 HUD scenes and the mama MP3.
# Keep the single factory image at the existing 0x10000 offset while giving it
# enough room for the embedded assets.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Control loop timing.
CONFIG_FREERTOS_HZ=100
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# 牛来快跑 application defaults (see main/Kconfig.projbuild).
# The public default is the safe BLE_ONLY stage: /OE stays HIGH and the
# PCA9685 is never initialized. Bench actuation is a separate, explicit
# overlay (sdkconfig.bench.defaults) and still requires the runtime gate.
CONFIG_NIULAI_MODE_BLE_ONLY=y
CONFIG_NIULAI_ACTIVE_LEG_FL=y
CONFIG_NIULAI_FOOT_CONTACT_TEST=n
CONFIG_NIULAI_GPIO39_CLI=n
CONFIG_NIULAI_WATCHDOG_TIMEOUT_MS=500
CONFIG_NIULAI_CONTROL_TICK_HZ=100
CONFIG_NIULAI_CONTACT_DEBOUNCE_TICKS=2
CONFIG_NIULAI_ACTUATION_ACCEPTANCE_WINDOW_S=1
CONFIG_NIULAI_STATE_TIMEOUT_MS=0
CONFIG_NIULAI_FSM_LIFT_DURATION_MS=200
CONFIG_NIULAI_FSM_SWING_SPEED=1000
CONFIG_NIULAI_FSM_SEARCH_SPEED=500
CONFIG_NIULAI_FSM_MAX_SWING=1000
CONFIG_NIULAI_ARD1_LIFT_DURATION_MS=300
CONFIG_NIULAI_ARD1_SWING_DURATION_MS=360
CONFIG_NIULAI_ARD1_SEARCH_DURATION_MS=120
CONFIG_NIULAI_ARD1_STEP_LENGTH_MM=30
CONFIG_NIULAI_ARD1_LIFT_Z_MM=-60
CONFIG_NIULAI_ARD1_TOUCHDOWN_Z_MM=-100

# Gerber_PCB1_2026-09-02 wiring defaults. /OE is active-low; the external
# 10 kΩ pull-up keeps outputs disabled during reset and before software init.
CONFIG_NIULAI_PCA9685_SDA_PIN=11
CONFIG_NIULAI_PCA9685_SCL_PIN=12
CONFIG_NIULAI_PCA9685_OE_PIN=1
CONFIG_NIULAI_PCA9685_I2C_ADDR=0x40
CONFIG_NIULAI_PCA9685_PWM_FREQ_HZ=50
CONFIG_NIULAI_FORMAL_FL_HIP_REST_US=1672
CONFIG_NIULAI_FORMAL_FL_KNEE_REST_US=1748
CONFIG_NIULAI_FORMAL_FR_HIP_REST_US=1494
CONFIG_NIULAI_FORMAL_FR_KNEE_REST_US=1165
CONFIG_NIULAI_FORMAL_RL_HIP_REST_US=1764
CONFIG_NIULAI_FORMAL_RL_KNEE_REST_US=1934
CONFIG_NIULAI_FORMAL_RR_HIP_REST_US=1368
CONFIG_NIULAI_FORMAL_RR_KNEE_REST_US=1279
CONFIG_NIULAI_FORMAL_CH0_MIN_US=1400
CONFIG_NIULAI_FORMAL_CH0_MAX_US=2500
CONFIG_NIULAI_FORMAL_CH1_MIN_US=500
CONFIG_NIULAI_FORMAL_CH1_MAX_US=2500
CONFIG_NIULAI_FORMAL_CH2_MIN_US=500
CONFIG_NIULAI_FORMAL_CH2_MAX_US=1750
CONFIG_NIULAI_FORMAL_CH3_MIN_US=500
CONFIG_NIULAI_FORMAL_CH3_MAX_US=2500
CONFIG_NIULAI_FORMAL_CH4_MIN_US=500
CONFIG_NIULAI_FORMAL_CH4_MAX_US=1940
CONFIG_NIULAI_FORMAL_CH5_MIN_US=500
CONFIG_NIULAI_FORMAL_CH5_MAX_US=2500
CONFIG_NIULAI_FORMAL_CH6_MIN_US=1120
CONFIG_NIULAI_FORMAL_CH6_MAX_US=2500
CONFIG_NIULAI_FORMAL_CH7_MIN_US=500
CONFIG_NIULAI_FORMAL_CH7_MAX_US=2500
CONFIG_NIULAI_FORMAL_MAX_PULSE_STEP_US=250

# Gerber nets: AMPDIN=GPIO4, I2SBCLK=GPIO9, I2SWS=GPIO10, MICSD=GPIO14.
CONFIG_NIULAI_I2S_BCLK_GPIO=9
CONFIG_NIULAI_I2S_WS_GPIO=10
CONFIG_NIULAI_I2S_TX_GPIO=4
CONFIG_NIULAI_I2S_RX_GPIO=14
CONFIG_NIULAI_AUDIO_TEST=n
CONFIG_NIULAI_AUDIO_VOLUME_PERCENT=50
CONFIG_NIULAI_VOICE_KEYWORD_TEST=n
CONFIG_NIULAI_MPU6500_PROBE_TEST=n
CONFIG_NIULAI_VOICE_VAD_RMS_THRESHOLD=500
CONFIG_NIULAI_VOICE_DISTANCE_THRESHOLD=40
CONFIG_NIULAI_VOICE_COOLDOWN_FRAMES=50
CONFIG_NIULAI_VOICE_I2S_SLOT=0
CONFIG_NIULAI_VOICE_I2S_SHIFT=16

# Gerber nets: ST7789BL=GPIO5, CS=GPIO6, DC=GPIO7, SCLK=GPIO8,
# RESET=GPIO16, MOSI=GPIO17.
CONFIG_NIULAI_DISPLAY_SCLK_GPIO=8
CONFIG_NIULAI_DISPLAY_MOSI_GPIO=17
CONFIG_NIULAI_DISPLAY_CS_GPIO=6
CONFIG_NIULAI_DISPLAY_DC_GPIO=7
CONFIG_NIULAI_DISPLAY_RESET_GPIO=16
CONFIG_NIULAI_DISPLAY_BACKLIGHT_GPIO=5
CONFIG_NIULAI_DISPLAY_WIDTH=170
CONFIG_NIULAI_DISPLAY_HEIGHT=320
CONFIG_NIULAI_DISPLAY_X_OFFSET=35
CONFIG_NIULAI_DISPLAY_Y_OFFSET=0
CONFIG_NIULAI_DISPLAY_MADCTL=0x00
CONFIG_NIULAI_DISPLAY_HUD_LANDSCAPE=n
CONFIG_NIULAI_DISPLAY_HUD_LANDSCAPE_X_OFFSET=0
CONFIG_NIULAI_DISPLAY_HUD_LANDSCAPE_Y_OFFSET=35
CONFIG_NIULAI_DISPLAY_HUD_LANDSCAPE_MADCTL=0x60
CONFIG_NIULAI_DISPLAY_BACKLIGHT_ACTIVE_HIGH=y

# KW10 leg mapping supplied by the Operator:
# GPIO39=FR, GPIO40=FL, GPIO41=RR, GPIO42=RL. The firmware exposes the
# debounced mask in bit order FL/FR/RL/RR. C-NC mechanical touchdown semantics
# and physical debounce duration still require bench verification.
CONFIG_NIULAI_CONTACT_PIN_FL=40
CONFIG_NIULAI_CONTACT_PIN_FR=39
CONFIG_NIULAI_CONTACT_PIN_RL=42
CONFIG_NIULAI_CONTACT_PIN_RR=41
CONFIG_NIULAI_I2S_SINE_TEST=n
CONFIG_NIULAI_I2S_SINE_AMPLITUDE_PERCENT=5
CONFIG_NIULAI_I2S_LOOPBACK_TEST=n
