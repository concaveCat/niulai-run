# Landscape TFT HUD preview profile.
# Combine after sdkconfig.defaults in a separate build directory.
CONFIG_NIULAI_DISPLAY_HUD_TEST=y
CONFIG_NIULAI_DISPLAY_HUD_LANDSCAPE=y
CONFIG_NIULAI_DISPLAY_HUD_LANDSCAPE_X_OFFSET=0
CONFIG_NIULAI_DISPLAY_HUD_LANDSCAPE_Y_OFFSET=35
CONFIG_NIULAI_DISPLAY_HUD_LANDSCAPE_MADCTL=0x60
